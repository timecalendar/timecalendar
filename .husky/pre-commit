#!/bin/sh
# .husky/_/ is gitignored, so a fresh worktree has no helper to source and the
# commit would die with an opaque `exit=2`. Skip loudly instead: with no
# node_modules, lint-staged could not run usefully anyway, and CI is the real gate.
if [ ! -f "$(dirname "$0")/_/husky.sh" ]; then
  echo "husky is not installed in this worktree - skipping pre-commit checks." >&2
  echo "Run 'npm run setup:worktree' (bin/setup-worktree.sh) to enable them." >&2
  exit 0
fi
. "$(dirname "$0")/_/husky.sh"

npx lint-staged
